{
  "id": "./",
  "name": "SANIX CRM Pro",
  "short_name": "SANIX CRM",
  "description": "CRM commercial SANIX Africa : prospects, pipeline, ventes, licences, déploiement et comptabilité — fonctionne aussi hors ligne",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0B1628",
  "theme_color": "#2563EB",
  "lang": "fr",
  "dir": "ltr",
  "categories": ["business", "productivity"],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Clients & Prospects", "short_name": "Clients", "url": "./?page=clients", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Pipeline commercial", "short_name": "Pipeline", "url": "./?page=pipeline", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Nouveau deal", "short_name": "Nouveau deal", "url": "./?page=new-deal", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Commandes", "short_name": "Commandes", "url": "./?page=commandes", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
